{
  "manifestVersion": 1,
  "id": "pitinga-database-migration-tasks",
  "name": "Flyway - Database Migration Tasks",
  "version": "1.2.0",
  "publisher": "pitinga",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "description": "Instala e executa Flyway em Azure Pipelines para versionamento e migrações de banco de dados",
  "categories": [
    "Azure Pipelines"
  ],
  "icons": {
    "default": "images/extension-icon.png"
  },
  "files": [
    {
      "path": "FlywayInstaller/.dist",
      "packagePath": "FlywayInstaller"
    },
    {
      "path": "FlywayCLI/.dist",
      "packagePath": "FlywayCLI"
    },
    {
      "path": "images/extension-icon.png",
      "addressable": true
    },
    {
      "path": "overview.md",
      "addressable": true
    }
  ],
  "content": {
    "details": {
      "path": "overview.md"
    }
  },
  "galleryFlags": [],
  "contributions": [
    {
      "id": "pitinga-flyway-installer",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "FlywayInstaller"
      }
    },
    {
      "id": "pitinga-flyway-cli",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "FlywayCLI"
      }
    }
  ],
  "repository": {
    "type": "git",
    "uri": "https://github.com/pitinga/azure-pipelines-tasks-flyway"
  }
}
