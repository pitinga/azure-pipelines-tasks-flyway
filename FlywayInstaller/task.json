{
  "category": "Utility",
  "visibility": [
    "Build",
    "Release"
  ],
  "minimumAgentVersion": "4.265.1",
  "author": "Pitinga",
  "execution": {
    "Node24": {
      "target": "index.cjs"
    }
  },
  "id": "cb3338c8-258b-4b56-90e5-c33a750de123",
  "name": "FlywayInstaller",
  "friendlyName": "Flyway Installer",
  "description": "Instala e disponibiliza Flyway no PATH",
  "version": {
    "Major": 1,
    "Minor": 0,
    "Patch": 0
  },
  "instanceNameFormat": "Install Flyway $(flywayVersion)",
  "inputs": [
    {
      "name": "flywayVersion",
      "type": "string",
      "label": "Versão",
      "defaultValue": "13.11.1",
      "required": true
    },
    {
      "name": "edition",
      "type": "pickList",
      "label": "Distribuição",
      "defaultValue": "redgate",
      "required": true,
      "options": {
        "redgate": "Redgate",
        "community": "Community"
      }
    },
    {
      "name": "sha256",
      "type": "string",
      "label": "SHA-256 opcional",
      "required": false
    }
  ]
}