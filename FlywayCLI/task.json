{
  "category": "Utility",
  "visibility": [
    "Build",
    "Release"
  ],
  "minimumAgentVersion": "4.265.1",
  "author": "Pitinga",
  "execution": {
    "Node24": {
      "target": "index.cjs"
    }
  },
  "id": "6bb67f4f-9f68-46f1-8a16-f1bf416a6c85",
  "name": "FlywayCLI",
  "friendlyName": "Flyway CLI",
  "description": "Executa comandos Flyway com credenciais via ambiente",
  "version": {
    "Major": 1,
    "Minor": 0,
    "Patch": 0
  },
  "instanceNameFormat": "Flyway $(command)",
  "inputs": [
    {
      "name": "command",
      "type": "pickList",
      "label": "Comando",
      "defaultValue": "migrate",
      "required": true,
      "options": {
        "migrate": "migrate",
        "validate": "validate",
        "info": "info",
        "baseline": "baseline",
        "repair": "repair",
        "clean": "clean"
      }
    },
    {
      "name": "workingDirectory",
      "type": "filePath",
      "label": "Diretório SQL",
      "defaultValue": "$(System.DefaultWorkingDirectory)",
      "required": true
    },
    {
      "name": "url",
      "type": "string",
      "label": "JDBC URL",
      "required": false
    },
    {
      "name": "user",
      "type": "string",
      "label": "Usuário do banco",
      "required": false
    },
    {
      "name": "password",
      "type": "string",
      "label": "Senha do banco (variável secreta)",
      "required": false
    },
    {
      "name": "commandOptions",
      "type": "multiLine",
      "label": "Opções adicionais",
      "required": false
    },
    {
      "name": "allowClean",
      "type": "boolean",
      "label": "Permitir CLEAN",
      "defaultValue": false,
      "required": false
    },
    {
      "name": "flywayPath",
      "type": "filePath",
      "label": "Executável Flyway opcional",
      "required": false
    }
  ]
}